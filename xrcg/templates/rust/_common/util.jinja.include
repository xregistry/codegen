{#- Rust utility macros -#}

{%- macro body_type(data_project_name, root, message) -%}
{%- if message.dataschemauri or message.dataschema -%}
{{ (message.dataschemauri if message.dataschemauri else message.dataschema) | schema_type(data_project_name, root, message.dataschemaformat) | rust_type }}
{%- else -%}
Vec<u8>
{%- endif %}
{%- endmacro -%}

{%- macro get_content_type(message) -%}
{%- set schema_format = message.dataschemaformat | default("", true) | lower -%}
{%- if schema_format.startswith("avro") -%}
"avro/binary"
{%- elif schema_format.startswith("proto") -%}
"application/protobuf"
{%- elif schema_format.startswith("xsd") or schema_format.startswith("xmlschema") -%}
{%- if message.envelopemetadata and "datacontenttype" in message.envelopemetadata and "value" in message.envelopemetadata.datacontenttype and message.envelopemetadata.datacontenttype.value -%}
"{{ message.envelopemetadata.datacontenttype.value }}"
{%- else -%}
"application/xml"
{%- endif -%}
{%- elif schema_format.startswith("jsonschema") or schema_format.startswith("jsonstructure") -%}
"application/json"
{%- elif message.envelope == "CloudEvents/1.0" and message.envelopemetadata and "datacontenttype" in message.envelopemetadata and "value" in message.envelopemetadata.datacontenttype -%}
"{{ message.envelopemetadata.datacontenttype.value }}"
{%- else -%}
"application/json"
{%- endif -%}
{%- endmacro -%}
