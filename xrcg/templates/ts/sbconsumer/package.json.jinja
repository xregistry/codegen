{%- import "util.jinja.include" as util -%}
{
  "name": "{{ project_name | lower | replace('.', '-') }}-servicebus-consumer",
  "version": "1.0.0",
  "type": "module",
  "description": "Azure Service Bus Consumer for {{ project_name }}",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "overrides": {{ util.DependencyOverrides() }},
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    {{ dependency("ts", "node22", "@azure/service-bus") }},
    {{ dependency("ts", "node22", "@azure/identity") }},
    {{ dependency("ts", "node22", "cloudevents") }}
  },
  "devDependencies": {
    {{ dependency("ts", "node22", "@jest/globals") }},
    {{ dependency("ts", "node22", "@types/jest") }},
    {{ dependency("ts", "node22", "@types/node") }},
    {{ dependency("ts", "node22", "jest") }},
    {{ dependency("ts", "node22", "testcontainers") }},
    {{ dependency("ts", "node22", "ts-jest") }},
    {{ dependency("ts", "node22", "typescript") }}
  }
}
