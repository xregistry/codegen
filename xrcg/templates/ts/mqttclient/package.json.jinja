{%- import "util.jinja.include" as util -%}
{
  "name": "{{ project_name | lower | replace('.', '-') }}-mqtt-client",
  "version": "1.0.0",
  "type": "module",
  "description": "MQTT Client for {{ project_name }}",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "overrides": {{ util.DependencyOverrides() }},
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    {{ dependency("ts", "node22", "mqtt") }},
    {{ dependency("ts", "node22", "cloudevents") }},
    {{ dependency("ts", "node22", "uuid") }}
  },
  "devDependencies": {
    {{ dependency("ts", "node22", "@jest/globals") }},
    {{ dependency("ts", "node22", "@types/jest") }},
    {{ dependency("ts", "node22", "@types/node") }},
    {{ dependency("ts", "node22", "@types/uuid") }},
    {{ dependency("ts", "node22", "aedes") }},
    {{ dependency("ts", "node22", "jest") }},
    {{ dependency("ts", "node22", "ts-jest") }},
    {{ dependency("ts", "node22", "typescript") }}
  }
}
