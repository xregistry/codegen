{%- import "util.jinja.include" as util -%}
{%- macro DeclarePackageJson( packageName ) -%}
{
  "name": "{{ packageName }}",
  "version": "1.0.0",
  "description": "CloudEvents SDK for JavaScript",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "overrides": {{ util.DependencyOverrides() }},
  "scripts": {
    "watch": "tsc --project tsconfig.json --watch",
    "build:src": "tsc --project tsconfig.json",
    "build:browser": "tsc --project tsconfig.browser.json && webpack",
    "build:schema": "ajv compile -c ./src/schema/formats.js -s src/schema/*.json --strict-types false -o src/schema/v1.js",
    "build": "npm run build:schema && npm run build:src && npm run build:browser",
    "lint": "eslint 'src/**/*.{js,ts}' 'test/**/*.{js,ts}'",
    "lint:fix": "eslint 'src/**/*.{js,ts}' 'test/**/*.{js,ts}' --fix",
    "pretest": "npm run lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "coverage-publish": "wget -qO - https://coverage.codacy.com/get.sh | bash -s report -l JavaScript -r coverage/lcov.info",
    "generate-docs": "typedoc --out docs src",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "bundles"
  ],
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    {{ dependency("ts", "node22", "uuid") }},
    {{ dependency("ts", "node22", "cloudevents") }}
  },
  "devDependencies": {
    {{ dependency("ts", "node22", "@jest/globals") }},
    {{ dependency("ts", "node22", "@types/jest") }},
    {{ dependency("ts", "node22", "@types/node") }},
    {{ dependency("ts", "node22", "@types/uuid") }},
    {{ dependency("ts", "node22", "@typescript-eslint/eslint-plugin") }},
    {{ dependency("ts", "node22", "@typescript-eslint/parser") }},
    {{ dependency("ts", "node22", "@stylistic/eslint-plugin") }},
    "ajv-cli": "^5.0.0",
    {{ dependency("ts", "node22", "eslint") }},
    {{ dependency("ts", "node22", "jest") }},
    {{ dependency("ts", "node22", "ts-jest") }},
    {{ dependency("ts", "node22", "ts-node") }},
    {{ dependency("ts", "node22", "typedoc") }},
    {{ dependency("ts", "node22", "typescript") }},
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
{%- endmacro -%}