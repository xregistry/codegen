{%- import "util.jinja.include" as util -%}
{
  "name": "{{ project_name | snake | replace('_', '-') }}",
  "version": "1.0.0",
  "type": "module",
  "description": "Azure Event Hubs consumer for {{ project_name }}",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "overrides": {{ util.DependencyOverrides() }},
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'test/**/*.ts' --fix"
  },
  "keywords": ["azure", "eventhubs", "consumer", "cloudevents"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    {{ dependency("ts", "node22", "@azure/event-hubs") }},
    "@azure/storage-blob": "^12.17.0",
    {{ dependency("ts", "node22", "@azure/identity") }},
    {{ dependency("ts", "node22", "cloudevents") }}
  },
  "devDependencies": {
    {{ dependency("ts", "node22", "@jest/globals") }},
    {{ dependency("ts", "node22", "@types/jest") }},
    {{ dependency("ts", "node22", "@types/node") }},
    {{ dependency("ts", "node22", "@typescript-eslint/eslint-plugin") }},
    {{ dependency("ts", "node22", "@typescript-eslint/parser") }},
    {{ dependency("ts", "node22", "@stylistic/eslint-plugin") }},
    {{ dependency("ts", "node22", "eslint") }},
    {{ dependency("ts", "node22", "jest") }},
    {{ dependency("ts", "node22", "ts-jest") }},
    {{ dependency("ts", "node22", "ts-node") }},
    {{ dependency("ts", "node22", "typescript") }}
  }
}
