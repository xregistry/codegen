{%- macro DeclareDataType(project_name, root, message) -%}
{%- if message.dataschemauri or message.dataschema -%}
{%- set dataType = ((message.dataschemauri if message.dataschemauri else message.dataschema) | schema_type( project_name, root, message.dataschemaformat) ) -%}
{%- set ns = dataType | namespace | lower -%}
{%- if ns -%}
{%- set dataType = ns + '.' + (dataType | strip_namespace | pascal) -%}
{%- else -%}
{%- set dataType = dataType | strip_namespace | pascal -%}
{%- endif -%}
{%- else -%}
{%- set dataType = "object" -%}
{%- endif -%}
{{ dataType }}
{%- endmacro -%}

{%- macro CollectMqttUriTemplateVariables(message, variables) -%}
{%- for attrname, attribute in message.envelopemetadata.items() -%}
{%- if attribute.value and attribute.type == "uritemplate" and attrname != "time" -%}
{%- for placeholder in attribute.value | regex_search('\\{([A-Za-z0-9_]+)\\}') -%}
{%- if placeholder not in variables -%}
{%- set _ = variables.append(placeholder) -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- endfor -%}
{%- set topic = none -%}
{%- if message.protocoloptions and message.protocoloptions.topic_name -%}
{%- set topic = message.protocoloptions.topic_name -%}
{%- elif message.protocoloptions and message.protocoloptions['topic-name'] -%}
{%- set topic = message.protocoloptions['topic-name'] -%}
{%- elif message.protocoloptions and message.protocoloptions.topic -%}
{%- set topic = message.protocoloptions.topic -%}
{%- endif -%}
{%- if topic -%}
{%- for placeholder in topic | regex_search('\\{([A-Za-z0-9_]+)\\}') -%}
{%- if placeholder not in variables -%}
{%- set _ = variables.append(placeholder) -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- endmacro -%}

{%- macro DeclareDataTestModule(data_project_name, type_name) -%}
{%- set root_package = data_project_name | dotunderscore | lower -%}
{%- set relative_type_name = type_name | replace(root_package + ".", "", 1) -%}
{%- if "." in relative_type_name -%}
{%- set flat_package = type_name | dotunderscore | lower -%}
{%- if flat_package.startswith('test_') -%}
{{ flat_package }}
{%- else -%}
{{ "test_" + flat_package }}
{%- endif -%}
{%- else -%}
{{ "test_" + (type_name | strip_namespace | lower) }}
{%- endif -%}
{%- endmacro -%}